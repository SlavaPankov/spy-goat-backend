generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userStats       UserStats?
  createdRooms    Room[]            @relation("RoomCreator")
  players         Player[]
  playerRoomStats PlayerRoomStats[]
  token           Token?

  name    String?
  surname String?
  email   String?

  isOnline Boolean @default(false)
  lastSeenAt DateTime?

  notifications Notification[]

  sentFriendRequests Friendship[] @relation("FriendRequester")
  receivedFriendRequests Friendship[] @relation("FriendAddressee")
  sentRoomInvites RoomInvite[] @relation("RoomInviteInviter")
  receivedRoomInvites RoomInvite[] @relation("RoomInviteInvitee")
  
  @@index([username])
}

model UserStats {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gamesPlayed  Int      @default(0)
  gamesWon     Int      @default(0)
  totalPenalty Int      @default(0)
  bestScore    Int?
  updatedAt    DateTime @updatedAt
}

model Room {
  id   String @id @default(uuid())
  name String
  code String @unique

  maxPlayers     Int        @default(4)
  currentPlayers Int        @default(0)
  isPrivate      Boolean    @default(false)
  status         RoomStatus @default(WAITING)
  withBots Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorId String
  creator   User   @relation("RoomCreator", fields: [creatorId], references: [id])

  players         Player[]
  games           Game[]
  roomStats       RoomStats?
  playerRoomStats PlayerRoomStats[]

  password String?

  messages Message[]

  roomInvites RoomInvite[]

  @@index([status, code])
}

enum RoomStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

model Game {
  id String @id @default(uuid())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  status GameStatus @default(IN_PROGRESS)

  currentRound Int @default(1)
  currentTurn  Int @default(1)

  rows             Json
  currentTurnCards Json @default("[]")
  history          Json @default("[]")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  players Player[] @relation("GamePlayers")

  winnerId String?
  winner   Player? @relation("GameWinner", fields: [winnerId], references: [id])

  @@index([roomId, status])
}

enum GameStatus {
  IN_PROGRESS
  FINISHED
}

model Player {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  gameId String?
  game   Game?   @relation("GamePlayers", fields: [gameId], references: [id], onDelete: SetNull)

  isBot    Boolean @default(false)
  botName  String?
  position Int

  hand             Json @default("[]")
  penaltyCard      Json @default("[]")
  totalPenalty     Int  @default(0)
  roundPenaltyCard Json @default("[]")
  roundPenalty     Int  @default(0)

  selectedCard            Json?
  isSelectedCardConfirmed Boolean @default(false)

  isReady       Boolean @default(false)
  isWinner      Boolean @default(false)
  finalPosition Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wonGames Game[] @relation("GameWinner")

  messages    Message[]
  messageReads MessageRead[]

  @@unique([gameId, position, userId])
  @@index([roomId, userId])
}

model RoomStats {
  id     String @id @default(uuid())
  roomId String @unique
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  totalGames     Int @default(0)
  completedGames Int @default(0)

  updatedAt DateTime @updatedAt
}

model PlayerRoomStats {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  gamesPlayed  Int  @default(0)
  gamesWon     Int  @default(0)
  totalPenalty Int  @default(0)
  bestScore    Int? // наименьшее количество штрафных очков

  lastPlayedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, roomId])
  @@index([roomId])
  @@index([userId])
}

model Message {
  id        String   @id @default(uuid())
  content   String
  iv        String
  createdAt DateTime @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  replyToId String?
  replyTo Message? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageReplies")

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  reads MessageRead[]

  @@index([roomId, createdAt])
}

model MessageRead {
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@id([messageId, playerId])
}

model Token {
  id           String   @id @default(uuid())
  userId       String   @unique
  refreshToken String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String
  payload Json @default("{}")
  readAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Friendship {
  id String @id @default(uuid())
  requesterId String
  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status FriendshipStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

enum RoomInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model RoomInvite {
  id String @id @default(uuid())

  roomId String
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  inviterId String
  inviter   User   @relation("RoomInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  inviteeId String
  invitee   User   @relation("RoomInviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)


  status RoomInviteStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, inviteeId])
  @@index([inviteeId, status])
  @@index([roomId, status])
}